@namespace TaskFlow.Web.Components.Layout

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <i class="bi bi-layers-half text-primary fs-4"></i>
            <span class="fw-bold fs-5 tracking-tight">TaskFlow</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tasks">
                <i class="bi bi-check2-square me-2"></i> Tasks
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="kanban">
                <i class="bi bi-kanban me-2"></i> Kanban Board
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                <i class="bi bi-folder2-open me-2"></i> Projects
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="calendar">
                <i class="bi bi-calendar3 me-2"></i> Calendar
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="analytics">
                <i class="bi bi-bar-chart-line-fill me-2"></i> Analytics
            </NavLink>
        </div>

        <hr class="text-white-50 mx-3 my-2" />

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <i class="bi bi-gear-fill me-2"></i> Settings
            </NavLink>
        </div>
    </nav>
</div>
