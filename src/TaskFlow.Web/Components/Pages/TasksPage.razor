@page "/tasks"
@rendermode InteractiveServer
@inject TaskService TaskService
@inject ProjectService ProjectService
@inject ToastService ToastService

<PageTitle>Tasks | TaskFlow</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Tasks</h3>
            <p class="text-muted small mb-0">Manage, prioritize, and track all work items</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg me-1"></i>New Task
            </button>
        </div>
    </div>

    <!-- Filters and Search Toolbar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Search tasks..." @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
                    </div>
                </div>

                <div class="col-sm-6 col-md-2">
                    <select class="form-select form-select-sm" @bind="selectedStatus" @bind:after="ApplyFiltersAsync">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<TaskItemStatus>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-sm-6 col-md-2">
                    <select class="form-select form-select-sm" @bind="selectedPriority" @bind:after="ApplyFiltersAsync">
                        <option value="">All Priorities</option>
                        @foreach (var p in Enum.GetValues<TaskPriority>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                <div class="col-sm-6 col-md-2">
                    <select class="form-select form-select-sm" @bind="selectedProjectId" @bind:after="ApplyFiltersAsync">
                        <option value="">All Projects</option>
                        @foreach (var prj in projects)
                        {
                            <option value="@prj.Id">@prj.Name</option>
                        }
                    </select>
                </div>

                <div class="col-sm-6 col-md-2">
                    <select class="form-select form-select-sm" @bind="sortBy" @bind:after="ApplyFiltersAsync">
                        <option value="urgency">Sort by Urgency (Engine)</option>
                        <option value="deadline">Sort by Deadline</option>
                        <option value="created">Sort by Created Date</option>
                        <option value="priority">Sort by Priority</option>
                    </select>
                </div>

                <div class="col-md-1 text-end">
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(viewMode == "cards" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => viewMode = "cards")" title="Cards View">
                            <i class="bi bi-grid-fill"></i>
                        </button>
                        <button class="btn @(viewMode == "table" ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => viewMode = "table")" title="Table View">
                            <i class="bi bi-list-ul"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tasks Display -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted small mt-2">Loading tasks...</p>
        </div>
    }
    else if (tasks.Count == 0)
    {
        <EmptyState Title="No tasks found" Description="No tasks match the active filters or search query." ActionText="Create Task" OnAction="OpenCreateModal" />
    }
    else if (viewMode == "cards")
    {
        <div class="row g-3">
            @foreach (var task in tasks)
            {
                <div class="col-md-6 col-lg-4">
                    <TaskCard Task="task" OnEdit="OpenEditModal" OnDelete="ConfirmDelete" OnManageDependencies="OpenDependencyModal" OnStatusChanged="ApplyFiltersAsync" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>Task</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Project</th>
                            <th>Effort</th>
                            <th>Deadline</th>
                            <th>Priority Score</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tasks)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold small">@t.Title</span>
                                    @if (!string.IsNullOrEmpty(t.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 250px;">@t.Description</div>
                                    }
                                </td>
                                <td><StatusBadge Status="t.Status" /></td>
                                <td><PriorityBadge Priority="t.Priority" /></td>
                                <td><span class="small text-muted">@(t.ProjectName ?? "—")</span></td>
                                <td><span class="small">@(t.EstimatedEffortHours > 0 ? $"{t.EstimatedEffortHours:F1}h" : "—")</span></td>
                                <td>
                                    <span class="small @(t.Deadline < DateTime.UtcNow && t.Status != TaskItemStatus.Completed ? "text-danger fw-semibold" : "")">
                                        @(t.Deadline?.ToString("yyyy-MM-dd") ?? "—")
                                    </span>
                                </td>
                                <td>
                                    @if (t.PriorityScore.HasValue)
                                    {
                                        <span class="badge bg-primary-subtle text-primary">@t.PriorityScore.Value.ToString("F1")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-light" @onclick="() => OpenDependencyModal(t)" title="Dependencies"><i class="bi bi-diagram-3"></i></button>
                                        <button class="btn btn-light" @onclick="() => OpenEditModal(t)" title="Edit"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-light text-danger" @onclick="() => ConfirmDelete(t)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modals -->
<TaskFormModal IsOpen="@isFormModalOpen" TaskToEdit="@taskToEdit" OnSaved="ApplyFiltersAsync" OnClosed="() => isFormModalOpen = false" />
<ConfirmationDialog IsOpen="@isDeleteModalOpen" Title="Delete Task" Message="@($"Are you sure you want to delete '{taskToDelete?.Title}'? This action cannot be undone.")" ConfirmText="Delete Task" OnConfirm="DeleteConfirmedAsync" OnCancel="() => isDeleteModalOpen = false" />
<DependencyModal IsOpen="@isDependencyModalOpen" Task="@taskForDependencies" OnClosed="() => isDependencyModalOpen = false" />

@code {
    private List<TaskItemDto> tasks = new();
    private List<ProjectDto> projects = new();
    private bool isLoading = true;

    // Filters
    private string searchTerm = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedPriority = string.Empty;
    private string selectedProjectId = string.Empty;
    private string sortBy = "urgency";
    private string viewMode = "cards";

    // Modals
    private bool isFormModalOpen;
    private TaskItemDto? taskToEdit;
    private bool isDeleteModalOpen;
    private TaskItemDto? taskToDelete;
    private bool isDependencyModalOpen;
    private TaskItemDto? taskForDependencies;

    protected override async Task OnInitializedAsync()
    {
        projects = (await ProjectService.GetAllProjectsAsync()).ToList();
        await ApplyFiltersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        isLoading = true;
        TaskItemStatus? status = Enum.TryParse<TaskItemStatus>(selectedStatus, out var s) ? s : null;
        TaskPriority? priority = Enum.TryParse<TaskPriority>(selectedPriority, out var p) ? p : null;
        Guid? projId = Guid.TryParse(selectedProjectId, out var g) ? g : null;

        var result = await TaskService.GetAllTasksAsync(status, priority, projId, searchTerm, sortBy);
        tasks = result.ToList();
        isLoading = false;
    }

    private void OpenCreateModal()
    {
        taskToEdit = null;
        isFormModalOpen = true;
    }

    private void OpenEditModal(TaskItemDto task)
    {
        taskToEdit = task;
        isFormModalOpen = true;
    }

    private void ConfirmDelete(TaskItemDto task)
    {
        taskToDelete = task;
        isDeleteModalOpen = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (taskToDelete is null) return;
        var result = await TaskService.DeleteTaskAsync(taskToDelete.Id);
        result.Match(
            _ =>
            {
                ToastService.ShowSuccess("Task deleted successfully!");
                isDeleteModalOpen = false;
                taskToDelete = null;
                ApplyFiltersAsync();
            },
            errors => ToastService.ShowError(string.Join("; ", errors)));
    }

    private void OpenDependencyModal(TaskItemDto task)
    {
        taskForDependencies = task;
        isDependencyModalOpen = true;
    }
}
