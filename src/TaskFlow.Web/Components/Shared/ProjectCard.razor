@namespace TaskFlow.Web.Components.Shared

<div class="card shadow-sm border-0 mb-3 project-card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title fw-bold text-truncate mb-0">
                @Project.Name
            </h5>
            <span class="badge @(Project.Status == ProjectStatus.Active ? "bg-success" : "bg-secondary")">
                @Project.Status
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Project.Description))
        {
            <p class="card-text text-muted small text-truncate-2 mb-3">
                @Project.Description
            </p>
        }

        <div class="mt-auto">
            <div class="mb-3">
                <ProgressBar Percentage="Project.CompletionPercentage" Label="Completion" />
            </div>

            <div class="d-flex justify-content-between text-muted small mb-3">
                <span>
                    <i class="bi bi-check2-circle me-1"></i>@Project.CompletedTaskCount / @Project.TaskCount tasks
                </span>
                <span>
                    <i class="bi bi-clock me-1"></i>@Project.CompletedEffort.ToString("F1")h / @Project.TotalEffort.ToString("F1")h
                </span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                @if (Project.Deadline.HasValue)
                {
                    <small class="text-muted">
                        <i class="bi bi-calendar-event me-1"></i>Due @Project.Deadline.Value.ToString("MMM dd, yyyy")
                    </small>
                }
                else
                {
                    <small class="text-muted">No deadline</small>
                }

                <div class="btn-group btn-group-sm">
                    @if (OnEdit.HasDelegate)
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => OnEdit.InvokeAsync(Project)">
                            <i class="bi bi-pencil"></i>
                        </button>
                    }
                    @if (OnDelete.HasDelegate)
                    {
                        <button class="btn btn-outline-danger" @onclick="() => OnDelete.InvokeAsync(Project)">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = null!;
    [Parameter] public EventCallback<ProjectDto> OnEdit { get; set; }
    [Parameter] public EventCallback<ProjectDto> OnDelete { get; set; }
}
