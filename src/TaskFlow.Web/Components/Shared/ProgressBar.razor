@namespace TaskFlow.Web.Components.Shared

<div class="progress-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
        @if (!string.IsNullOrEmpty(Label))
        {
            <span>@Label</span>
        }
        <span class="fw-semibold">@Percentage.ToString("F1")%</span>
    </div>
    <div class="progress" style="height: @(Height)px;">
        <div class="progress-bar @BarClass" 
             role="progressbar" 
             style="width: @(Math.Clamp(Percentage, 0, 100))%;" 
             aria-valuenow="@Percentage" 
             aria-valuemin="0" 
             aria-valuemax="100">
        </div>
    </div>
</div>

@code {
    [Parameter] public double Percentage { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public int Height { get; set; } = 8;

    private string BarClass => Percentage switch
    {
        >= 100 => "bg-success",
        >= 70 => "bg-primary",
        >= 30 => "bg-info",
        _ => "bg-warning"
    };
}
