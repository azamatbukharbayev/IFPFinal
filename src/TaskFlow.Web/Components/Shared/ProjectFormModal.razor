@namespace TaskFlow.Web.Components.Shared
@inject ProjectService ProjectService
@inject ToastService ToastService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@(IsEditing ? "Edit Project" : "Create New Project")</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body py-3">
                    @if (Errors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 mb-3">
                            <ul class="mb-0 small ps-3">
                                @foreach (var err in Errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Project Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="Name" placeholder="Project name..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea class="form-control" rows="3" @bind="Description" placeholder="Project goals and scope..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Deadline</label>
                        <input type="date" class="form-control" @bind="Deadline" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(IsEditing ? "Save Changes" : "Create Project")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ProjectDto? ProjectToEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string Name { get; set; } = string.Empty;
    private string? Description { get; set; }
    private DateTime? Deadline { get; set; }
    private List<string> Errors { get; set; } = new();
    private bool IsSaving { get; set; }
    private bool IsEditing => ProjectToEdit is not null;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Errors.Clear();
            if (ProjectToEdit is not null)
            {
                Name = ProjectToEdit.Name;
                Description = ProjectToEdit.Description;
                Deadline = ProjectToEdit.Deadline;
            }
            else
            {
                Name = string.Empty;
                Description = null;
                Deadline = null;
            }
        }
    }

    private async Task SaveAsync()
    {
        Errors.Clear();
        IsSaving = true;

        try
        {
            if (IsEditing)
            {
                var dto = new UpdateProjectDto(ProjectToEdit!.Id, Name, Description, Deadline);
                var result = await ProjectService.UpdateProjectAsync(dto);
                result.Match(
                    _ =>
                    {
                        ToastService.ShowSuccess("Project updated!");
                        OnSaved.InvokeAsync();
                        Close();
                    },
                    errs => Errors.AddRange(errs));
            }
            else
            {
                var dto = new CreateProjectDto(Name, Description, Deadline);
                var result = await ProjectService.CreateProjectAsync(dto);
                result.Match(
                    _ =>
                    {
                        ToastService.ShowSuccess("Project created!");
                        OnSaved.InvokeAsync();
                        Close();
                    },
                    errs => Errors.AddRange(errs));
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void Close()
    {
        IsOpen = false;
        OnClosed.InvokeAsync();
    }
}
