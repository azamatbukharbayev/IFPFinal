@namespace TaskFlow.Web.Components.Shared

<div class="text-center py-5 empty-state">
    <div class="empty-icon mb-3">
        <i class="@Icon fs-1 text-muted opacity-50"></i>
    </div>
    <h5 class="fw-semibold text-secondary">@Title</h5>
    <p class="text-muted small mb-3">@Description</p>
    @if (OnAction.HasDelegate && !string.IsNullOrEmpty(ActionText))
    {
        <button class="btn btn-primary btn-sm" @onclick="OnAction">
            <i class="bi bi-plus-lg me-1"></i>@ActionText
        </button>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi bi-inbox";
    [Parameter] public string Title { get; set; } = "No items found";
    [Parameter] public string Description { get; set; } = "There are no records to display.";
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
